{
  "name": "irudd-le",
  "description": "Workspace for the Last Epoch passive content shell",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test": "corepack pnpm -r --if-present run test",
    "dev": "corepack pnpm --filter @irudd-le/overlay dev",
    "start": "corepack pnpm --filter @irudd-le/overlay start",
    "start:interactive": "corepack pnpm --filter @irudd-le/overlay start:interactive",
    "package:win": "corepack pnpm --filter @irudd-le/overlay package:win"
  }
}
