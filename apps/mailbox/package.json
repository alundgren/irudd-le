{
  "name": "@irudd-le/mailbox",
  "version": "0.1.0",
  "description": "Durable SQLite-backed mailbox and canonical HTTP API for the content shell (#34)",
  "private": true,
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "scripts": {
    "build": "corepack pnpm --reporter=append-only --filter @irudd-le/protocol build && tsc -p tsconfig.json",
    "typecheck": "corepack pnpm --reporter=append-only --filter @irudd-le/protocol build && tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm --reporter=append-only build && node --test --test-reporter=dot build/*.test.js",
    "test:focused": "corepack pnpm --reporter=append-only build && node ../../scripts/run-focused-test.mjs",
    "test:container": "bash scripts/container-smoke.sh",
    "start": "corepack pnpm build && node build/index.js"
  },
  "dependencies": {
    "@irudd-le/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
